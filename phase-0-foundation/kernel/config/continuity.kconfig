# Continuum OS — continuity subsystem hardware-support fragment
# Enables BLE/Wi-Fi Direct/V4L2-virtual-device support needed by daemons
# introduced in Phase 2+ (docs/architecture/06-continuity-subsystem.md).
# Enabled in Phase 0 so hardware bring-up isn't blocked later.

CONFIG_BT=y
CONFIG_BT_LE=y
CONFIG_BT_BREDR=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_CFG80211_WEXT=y
# Wi-Fi Direct / Wi-Fi Aware support depends on chipset driver + wpa_supplicant
# userspace; kernel-side is cfg80211 P2P support, enabled above.
CONFIG_VIDEO_V4L2=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_V4L2LOOPBACK=m
