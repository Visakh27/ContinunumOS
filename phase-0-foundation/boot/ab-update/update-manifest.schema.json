{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuum OS Update Manifest",
  "type": "object",
  "required": ["manifest_version", "os_version", "release_channel", "payload", "signature"],
  "properties": {
    "manifest_version": { "type": "integer", "const": 1 },
    "os_version": { "type": "string", "description": "semver, e.g. 0.1.0-phase0" },
    "release_channel": { "type": "string", "enum": ["dev", "beta", "lts"] },
    "minimum_compatible_version": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["delta_url", "delta_sha256", "full_image_sha256", "size_bytes"],
      "properties": {
        "delta_url": { "type": "string", "format": "uri" },
        "delta_sha256": { "type": "string" },
        "full_image_sha256": { "type": "string" },
        "size_bytes": { "type": "integer" }
      }
    },
    "rollout": {
      "type": "object",
      "properties": {
        "cohort_percentage": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "value", "key_id"],
      "properties": {
        "algorithm": { "type": "string", "const": "ed25519" },
        "value": { "type": "string" },
        "key_id": { "type": "string" }
      }
    }
  }
}
